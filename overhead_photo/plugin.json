{
  "tesserae_compat": "1.x",
  "name": "Overhead: Photo",
  "version": "0.11.3",
  "kind": "widget",
  "tesserae_min": "0.463.0",
  "description": "The nearest aircraft to a place, right now, as a full-bleed photograph of the very airframe (planespotters.net) with its callsign, type, route, height and distance, and the next few along a strip. Positions from adsb.lol or adsb.fi, or a receiver of your own.",
  "icon": "ph-airplane-in-flight",
  "supports": {
    "sizes": [
      "sm",
      "md",
      "lg"
    ]
  },
  "requires": [
    "network:*",
    "settings:plugin/overhead_core",
    "plugin:overhead_core"
  ],
  "render": {
    "needs_network": true,
    "warm_ahead_s": 150
  },
  "design": {
    "palette": "extended"
  },
  "cell_options": [
    {
      "name": "source",
      "type": "select",
      "label": "Positions from",
      "default": "adsb_lol",
      "choices": [
        {
          "value": "adsb_lol",
          "label": "The community feeds (adsb.lol, adsb.fi; no key)"
        },
        {
          "value": "receiver",
          "label": "A receiver of your own"
        }
      ],
      "help": "adsb.lol aggregates thousands of receivers and needs nothing from you; when it is slow or down the widget asks adsb.fi instead. A receiver of your own (readsb, dump1090, tar1090) answers at /data/aircraft.json and sees what it sees."
    },
    {
      "name": "receiver_url",
      "type": "string",
      "label": "Receiver address",
      "default": "",
      "help": "For example http://pi.local:8080; the widget asks for /data/aircraft.json.",
      "show_if": {
        "source": "receiver"
      }
    },
    {
      "name": "location",
      "type": "location_search",
      "label": "Place",
      "default": "",
      "help": "The point the distances and bearings are from. Falls back to the app's location."
    },
    {
      "name": "radius_km",
      "type": "select",
      "label": "Within",
      "default": "25",
      "choices": [
        {
          "value": "5",
          "label": "5 km"
        },
        {
          "value": "10",
          "label": "10 km"
        },
        {
          "value": "15",
          "label": "15 km"
        },
        {
          "value": "25",
          "label": "25 km"
        },
        {
          "value": "35",
          "label": "35 km"
        },
        {
          "value": "50",
          "label": "50 km"
        },
        {
          "value": "80",
          "label": "80 km"
        }
      ]
    },
    {
      "name": "strip",
      "type": "number",
      "label": "How many along the strip",
      "default": 5,
      "help": "0 to 8 after the nearest."
    },
    {
      "name": "paper",
      "type": "select",
      "label": "Paper",
      "default": "cream",
      "choices": [
        {
          "value": "cream",
          "label": "Cream"
        },
        {
          "value": "white",
          "label": "White"
        },
        {
          "value": "aged",
          "label": "Aged"
        },
        {
          "value": "blueprint",
          "label": "Blueprint: pale ink on blue"
        },
        {
          "value": "sky",
          "label": "A soft sky wash"
        }
      ]
    },
    {
      "name": "include_ground",
      "type": "boolean",
      "label": "Include aircraft on the ground",
      "default": false,
      "advanced": true
    },
    {
      "name": "kinds",
      "type": "multiselect",
      "label": "Kinds of aircraft",
      "default": [
        "wide",
        "jet",
        "biz",
        "prop",
        "light",
        "heli"
      ],
      "help": "The kinds the page shows; the rest are left out before the count is taken, so a page near a busy airfield is not all light aircraft and helicopters. Each aircraft's kind comes from its type code; one the widget does not know counts as a jet.",
      "choices": [
        {
          "value": "wide",
          "label": "Wide-body airliners"
        },
        {
          "value": "jet",
          "label": "Narrow-body jets"
        },
        {
          "value": "biz",
          "label": "Business jets"
        },
        {
          "value": "prop",
          "label": "Turboprops"
        },
        {
          "value": "light",
          "label": "Light aircraft, gliders and balloons"
        },
        {
          "value": "heli",
          "label": "Helicopters"
        }
      ],
      "advanced": true
    },
    {
      "name": "order",
      "type": "select",
      "label": "Order",
      "default": "nearest",
      "choices": [
        {
          "value": "nearest",
          "label": "Nearest first"
        },
        {
          "value": "lowest",
          "label": "Lowest first"
        },
        {
          "value": "highest",
          "label": "Highest first"
        },
        {
          "value": "largest",
          "label": "Largest first"
        },
        {
          "value": "fastest",
          "label": "Fastest first"
        }
      ],
      "advanced": true
    },
    {
      "name": "period",
      "type": "select",
      "label": "Show",
      "default": "now",
      "choices": [
        {
          "value": "now",
          "label": "What is within reach now"
        },
        {
          "value": "since",
          "label": "Everything that passed since the last render"
        }
      ],
      "help": "Since the last render keeps a watch on the place between renders (the community feeds every minute, a receiver every thirty seconds) and shows every aircraft seen since the page was last drawn for a panel, each at its closest approach with the time, so a page drawn every hour is the hour's traffic rather than one moment of it. The order and the count apply to what was seen. The editor's previews show the same window without moving it on; the watch stops three hours after a page last asked, and a first render shows the last hour.",
      "advanced": true
    },
    {
      "name": "photo_fit",
      "type": "select",
      "label": "Photograph fit",
      "default": "cover",
      "choices": [
        {
          "value": "cover",
          "label": "Fills the page"
        },
        {
          "value": "contain",
          "label": "Fits inside the page"
        }
      ],
      "advanced": true
    },
    {
      "name": "labels",
      "type": "multiselect",
      "label": "Label lines",
      "default": [
        "route",
        "altitude",
        "distance",
        "speed"
      ],
      "help": "In this order, under or beside each aircraft.",
      "choices": [
        {
          "value": "airline",
          "label": "Airline"
        },
        {
          "value": "type",
          "label": "Type"
        },
        {
          "value": "reg",
          "label": "Registration"
        },
        {
          "value": "route",
          "label": "Route"
        },
        {
          "value": "altitude",
          "label": "Altitude and trend"
        },
        {
          "value": "distance",
          "label": "Distance and bearing"
        },
        {
          "value": "speed",
          "label": "Ground speed"
        },
        {
          "value": "heading",
          "label": "Heading"
        },
        {
          "value": "seen",
          "label": "When it was within reach"
        }
      ],
      "advanced": true
    },
    {
      "name": "logos",
      "type": "select",
      "label": "Airline logos",
      "default": "off",
      "choices": [
        {
          "value": "off",
          "label": "Off: the airline's name"
        },
        {
          "value": "on",
          "label": "On: fetched from the web"
        }
      ],
      "help": "The airlines' own marks, fetched at render time from the service chosen in the Overhead Core settings and kept on your server; nothing ships with the widget. They are the airlines' trademarks: keep this off on anything you publish.",
      "advanced": true
    },
    {
      "name": "title",
      "type": "string",
      "label": "Title",
      "default": "",
      "help": "Blank uses the place.",
      "advanced": true
    },
    {
      "name": "header",
      "type": "select",
      "label": "Title line",
      "default": "top",
      "choices": [
        {
          "value": "top",
          "label": "Above the page"
        },
        {
          "value": "bottom",
          "label": "Below the page"
        },
        {
          "value": "hidden",
          "label": "Hidden"
        }
      ],
      "advanced": true
    },
    {
      "name": "footer",
      "type": "select",
      "label": "Foot of the page",
      "default": "show",
      "choices": [
        {
          "value": "show",
          "label": "Status and credits"
        },
        {
          "value": "credits",
          "label": "Credits only"
        },
        {
          "value": "hide",
          "label": "Nothing"
        }
      ],
      "advanced": true
    },
    {
      "name": "panel",
      "type": "select",
      "label": "Panel",
      "default": "colour",
      "choices": [
        {
          "value": "colour",
          "label": "Colour"
        },
        {
          "value": "gray16",
          "label": "16 greys"
        },
        {
          "value": "gray4",
          "label": "4 greys"
        },
        {
          "value": "mono",
          "label": "Black and white"
        }
      ],
      "help": "What the panel can show. Pictures are converted and contrast-stretched to match.",
      "advanced": true
    },
    {
      "name": "text_size",
      "type": "select",
      "label": "Text size",
      "default": "100",
      "choices": [
        {
          "value": "60",
          "label": "60%"
        },
        {
          "value": "80",
          "label": "80%"
        },
        {
          "value": "100",
          "label": "100%"
        },
        {
          "value": "125",
          "label": "125%"
        },
        {
          "value": "150",
          "label": "150%"
        }
      ],
      "advanced": true
    },
    {
      "name": "font",
      "type": "select",
      "label": "Typeface",
      "default": "fell",
      "choices": [
        {
          "value": "fell",
          "label": "IM Fell English: the old plate"
        },
        {
          "value": "archivo",
          "label": "Archivo Narrow: clean and plain"
        },
        {
          "value": "georgia",
          "label": "Georgia: a modern serif"
        },
        {
          "value": "page",
          "label": "The dashboard's own font"
        }
      ],
      "help": "The face the page is set in. The dashboard's own font follows the page's font picker.",
      "advanced": true
    }
  ],
  "data_schema": {
    "fields": [
      {
        "name": "title",
        "type": "str",
        "label": "Title"
      },
      {
        "name": "airborne",
        "type": "num",
        "label": "Aircraft airborne within reach"
      },
      {
        "name": "aircraft",
        "type": "arr",
        "label": "Aircraft shown"
      }
    ]
  }
}
