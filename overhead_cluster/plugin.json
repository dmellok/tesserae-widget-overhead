{
  "tesserae_compat": "1.x",
  "name": "Overhead: Cluster",
  "version": "0.1.14",
  "kind": "widget",
  "description": "Everything in the air near a place on one page: each aircraft painted from its own photograph and cut out, sized by its wingspan, with a caption; or, with photographs, a spotter's log of cards. Twelve styles, a style builder and your own prompt.",
  "icon": "ph-airplane-tilt",
  "supports": {
    "sizes": [
      "sm",
      "md",
      "lg"
    ]
  },
  "requires": [
    "network:*",
    "settings:plugin/overhead_core",
    "plugin:overhead_core"
  ],
  "render": {
    "needs_network": true
  },
  "design": {
    "palette": "extended"
  },
  "cell_options": [
    {
      "name": "source",
      "type": "select",
      "label": "Positions from",
      "default": "adsb_lol",
      "choices": [
        {
          "value": "adsb_lol",
          "label": "adsb.lol (the community feed, no key)"
        },
        {
          "value": "receiver",
          "label": "A receiver of your own"
        }
      ],
      "help": "adsb.lol aggregates thousands of receivers and needs nothing from you. A receiver of your own (readsb, dump1090, tar1090) answers at /data/aircraft.json and sees what it sees."
    },
    {
      "name": "receiver_url",
      "type": "string",
      "label": "Receiver address",
      "default": "",
      "help": "For example http://pi.local:8080; the widget asks for /data/aircraft.json.",
      "show_if": {
        "source": "receiver"
      }
    },
    {
      "name": "location",
      "type": "location_search",
      "label": "Place",
      "default": "",
      "help": "The point the distances and bearings are from. Falls back to the app's location."
    },
    {
      "name": "radius_km",
      "type": "select",
      "label": "Within",
      "default": "25",
      "choices": [
        {
          "value": "5",
          "label": "5 km"
        },
        {
          "value": "10",
          "label": "10 km"
        },
        {
          "value": "15",
          "label": "15 km"
        },
        {
          "value": "25",
          "label": "25 km"
        },
        {
          "value": "35",
          "label": "35 km"
        },
        {
          "value": "50",
          "label": "50 km"
        },
        {
          "value": "80",
          "label": "80 km"
        }
