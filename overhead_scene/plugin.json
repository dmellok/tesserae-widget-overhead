{
  "tesserae_compat": "1.x",
  "name": "Overhead: Scene",
  "version": "0.8.0",
  "kind": "widget",
  "tesserae_min": "0.463.0",
  "description": "The nearest aircraft as one whole painting across the page: the airframe from its own photograph on a painted backdrop (sky, clouds, sunset, night, storm or an ornate plate), with its particulars set over it. Its photograph without a fal.ai key.",
  "icon": "ph-cloud-sun",
  "supports": {
    "sizes": [
      "sm",
      "md",
      "lg"
    ]
  },
  "requires": [
    "network:*",
    "settings:plugin/overhead_core",
    "plugin:overhead_core"
  ],
  "render": {
    "needs_network": true,
    "warm_ahead_s": 150
  },
  "design": {
    "palette": "extended"
  },
  "cell_options": [
    {
      "name": "source",
      "type": "select",
      "label": "Positions from",
      "default": "adsb_lol",
      "choices": [
        {
          "value": "adsb_lol",
          "label": "The community feeds (adsb.lol, adsb.fi; no key)"
        },
        {
          "value": "receiver",
          "label": "A receiver of your own"
        }
      ],
      "help": "adsb.lol aggregates thousands of receivers and needs nothing from you; when it is slow or down the widget asks adsb.fi instead. A receiver of your own (readsb, dump1090, tar1090) answers at /data/aircraft.json and sees what it sees."
    },
    {
      "name": "receiver_url",
      "type": "string",
      "label": "Receiver address",
      "default": "",
      "help": "For example http://pi.local:8080; the widget asks for /data/aircraft.json.",
      "show_if": {
        "source": "receiver"
      }
    },
    {
      "name": "location",
      "type": "location_search",
      "label": "Place",
      "default": "",
      "help": "The point the distances and bearings are from. Falls back to the app's location."
    },
    {
      "name": "radius_km",
      "type": "select",
      "label": "Within",
      "default": "25",
      "choices": [
        {
          "value": "5",
          "label": "5 km"
        },
        {
          "value": "10",
          "label": "10 km"
        },
        {
          "value": "15",
          "label": "15 km"
        },
        {
          "value": "25",
          "label": "25 km"
        },
        {
          "value": "35",
          "label": "35 km"
        },
        {
          "value": "50",
          "label": "50 km"
        },
        {
          "value": "80",
          "label": "80 km"
        }
      ]
    },
    {
      "name": "pictures",
      "type": "select",
      "label": "Pictures",
      "default": "photos",
      "choices": [
        {
          "value": "photos",
          "label": "Photographs of the airframe (planespotters.net)"
        },
        {
          "value": "paintings",
          "label": "AI paintings, each from its own photograph"
        }
      ],
      "help": "Photographs cost nothing. AI paintings paint each airframe once, from its photograph, in the style below, at about US$0.04 a painting; needs a fal.ai key in the Overhead Core settings."
    },
    {
      "name": "style",
