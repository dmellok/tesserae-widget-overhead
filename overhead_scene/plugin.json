    {
      "name": "build_extra",
      "type": "string",
      "label": "Your own words",
      "default": "",
      "show_if": {
        "pictures": "paintings",
        "style": "builder"
      },
      "help": "Added to the style: for example, with a little gold leaf on the tail."
    },
    {
      "name": "backdrop",
      "type": "select",
      "label": "Backdrop",
      "default": "sky",
      "choices": [
        {
          "value": "live",
          "label": "The sky as it is now: time of day and weather"
        },
        {
          "value": "sky",
          "label": "A clear sky"
        },
        {
          "value": "clouds",
          "label": "Above the clouds"
        },
        {
          "value": "sunset",
          "label": "Sunset"
        },
        {
          "value": "night",
          "label": "Night"
        },
        {
          "value": "storm",
          "label": "Storm light"
        },
        {
          "value": "ornate",
          "label": "Ornate framed plate"
        }
      ],
      "show_if": {
        "pictures": "paintings"
      },
      "help": "None keeps the aircraft alone on the page, cut out. The rest paint a whole picture that fills its frame, in the same style. The sky as it is now takes the time of day (dawn, morning, midday, afternoon, dusk, night) and the weather (Open-Meteo: clear, cloud, overcast, fog, rain, snow, storm) at the place, and paints each condition once per aircraft, so a changing sky costs more paintings."
    },
    {
      "name": "paper",
      "type": "select",
      "label": "Paper",
      "default": "cream",
      "choices": [
        {
          "value": "cream",
          "label": "Cream"
        },
        {
          "value": "white",
          "label": "White"
        },
        {
          "value": "aged",
          "label": "Aged"
        },
        {
          "value": "blueprint",
          "label": "Blueprint: pale ink on blue"
        },
        {
          "value": "sky",
          "label": "A soft sky wash"
        }
      ]
    },
    {
      "name": "include_ground",
      "type": "boolean",
      "label": "Include aircraft on the ground",
      "default": false,
      "advanced": true
    },
    {
      "name": "kinds",
      "type": "multiselect",
      "label": "Kinds of aircraft",
      "default": [
        "wide",
        "jet",
        "biz",
        "prop",
        "light",
        "heli"
      ],
      "help": "The kinds the page shows; the rest are left out before the count is taken, so a page near a busy airfield is not all light aircraft and helicopters. Each aircraft's kind comes from its type code; one the widget does not know counts as a jet.",
      "choices": [
        {
          "value": "wide",
          "label": "Wide-body airliners"
        },
        {
          "value": "jet",
          "label": "Narrow-body jets"
        },
        {
          "value": "biz",
          "label": "Business jets"
        },
        {
          "value": "prop",
          "label": "Turboprops"
        },
        {
          "value": "light",
          "label": "Light aircraft, gliders and balloons"
        },
        {
          "value": "heli",
          "label": "Helicopters"
        }
      ],
      "advanced": true
    },
    {
      "name": "order",
      "type": "select",
      "label": "Order",
      "default": "nearest",
      "choices": [
        {
          "value": "nearest",
          "label": "Nearest first"
        },
        {
          "value": "lowest",
          "label": "Lowest first"
        },
        {
          "value": "highest",
          "label": "Highest first"
        },
        {
          "value": "largest",
          "label": "Largest first"
        },
        {
          "value": "fastest",
          "label": "Fastest first"
        }
      ],
      "advanced": true
    },
    {
      "name": "period",
      "type": "select",
      "label": "Show",
      "default": "now",
      "choices": [
        {
          "value": "now",
          "label": "What is within reach now"
        },
        {
          "value": "since",
          "label": "Everything that passed since the last render"
        }
      ],
      "help": "Since the last render keeps a watch on the place between renders (the community feeds every minute, a receiver every thirty seconds) and shows every aircraft seen since the page was last drawn for a panel, each at its closest approach with the time, so a page drawn every hour is the hour's traffic rather than one moment of it. The order and the count apply to what was seen. The editor's previews show the same window without moving it on; the watch stops three hours after a page last asked, and a first render shows the last hour.",
      "advanced": true
    },
    {
      "name": "fidelity",
      "type": "select",
      "label": "Faithfulness",
      "default": "photo",
      "choices": [
        {
          "value": "photo",
          "label": "As photographed: the same angle, every mark of the livery"
        },
        {
          "value": "free",
          "label": "Drawn afresh: the model's own composition, the view below"
        }
      ],
      "show_if": {
        "pictures": "paintings"
      },
      "help": "As photographed translates the airframe's photograph into the medium and keeps its angle, livery, lettering and registration exactly. Drawn afresh lets the model compose the aircraft anew in the style, in the view chosen below; liveries drift more.",
      "advanced": true
    },
    {
      "name": "view",
      "type": "select",
      "label": "View",
      "default": "side",
      "choices": [
        {
          "value": "side",
          "label": "From the side, a little below"
        },
        {
          "value": "livery",
          "label": "Side-on: a pure profile, as a livery drawing"
        },
        {
          "value": "quarter",
          "label": "From the front quarter"
        },
        {
          "value": "above",
          "label": "From above, banking"
        }
      ],
      "show_if": {
        "pictures": "paintings",
        "fidelity": "free"
      },
      "advanced": true
    },
    {
      "name": "model",
      "type": "select",
      "label": "Model",
      "default": "nano_banana",
      "choices": [
        {
          "value": "nano_banana",
          "label": "Nano Banana (about US$0.04)"
        },
        {
          "value": "nano_banana_pro",
          "label": "Nano Banana Pro (about US$0.15)"
        },
        {
          "value": "flux_kontext",
          "label": "FLUX.1 Kontext Pro (about US$0.04)"
        },
        {
          "value": "gpt_image",
          "label": "GPT Image 2 (about US$0.05)"
        },
        {
          "value": "seedream",
          "label": "Seedream 4 (about US$0.03)"
        }
      ],
      "show_if": {
        "pictures": "paintings"
      },
      "help": "All on fal.ai, all painting from the photograph. Nano Banana is faithful and cheap; on Nano Banana, pixel art, stained glass, low-poly, paper craft, toy bricks and risograph are painted with GPT Image 2 (about US$0.05), as Nano Banana keeps them close to the photograph. Nano Banana Pro follows every style further.",
      "advanced": true
    },
    {
      "name": "no_photo",
      "type": "select",
      "label": "Without a photograph of the airframe",
      "default": "type",
      "choices": [
        {
          "value": "type",
          "label": "Paint it from a photograph of its type"
        },
        {
          "value": "silhouette",
          "label": "Show a silhouette"
        }
      ],
      "show_if": {
        "pictures": "paintings"
      },
      "help": "planespotters.net has no photograph of many light aircraft and helicopters. Painted from its type, such an airframe is painted from the lead picture of its type's Wikipedia article (Wikimedia Commons, credited on the page) in the operator's colours or plain white, with no registration; with no picture of the type, from its type's name alone. One painting serves every airframe of a type and operator, so a private Robinson R44 is painted once.",
      "advanced": true
    },
    {
      "name": "ufo",
      "type": "slider",
      "label": "Chance of a UFO",
      "default": 0,
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "show_if": {
        "pictures": "paintings"
      },
      "help": "Each hour, this chance that an unidentified contact joins the page, painted in the page's style, with no transponder and a made-up height and bearing. For fun. Each craft in a style is one painting against the daily limit.",
      "advanced": true
    },
    {
      "name": "visitors",
      "type": "multiselect",
      "label": "Who visits",
      "default": [
        "saucer",
        "triangle",
        "cigar",
        "orb",
        "tictac",
        "adamski"
      ],
      "show_if": {
        "pictures": "paintings",
        "ufo": {
          "not": 0
        }
      },
      "help": "Tick the craft the roll may bring. Most are painted from a reference picture (Wikimedia Commons and NASA, credited on the page). A craft from film and television is named to the painter along with its shape; if a model refuses the name, it is asked again by the shape alone. A picture of your own for any craft goes in the Overhead Core settings. With nothing ticked, the classic UFOs.",
      "choices": [
